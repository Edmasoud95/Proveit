generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  username     String      @unique
  passwordHash String
  role         String      @default("member") // "admin" | "member"
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  sessions     Session[]
  pocConfigs   PocConfig[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique // sha256 hex of the raw cookie token
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PocConfig {
  id           String   @id @default(uuid())
  name         String
  description  String
  systemPrompt String
  tools        String   @default("[]") // JSON array of tool definitions
  metadata     String   @default("{}") // JSON metadata
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  currentConfigVersionId String?
  ownerId                String?
  owner                  User?   @relation(fields: [ownerId], references: [id])

  evalCases          EvalCase[]
  llmConnections     LlmConnection[]
  taskModelOverrides TaskModelOverride[]
  evalRuns           EvalRun[]
  evalSuiteVersions  EvalSuiteVersion[]
  configVersions     PocConfigVersion[]
}

model EvalCase {
  id             String    @id @default(uuid())
  pocConfigId    String
  name           String
  input          String    // JSON
  judgeCriteria  String
  order          Int       @default(0)
  createdAt      DateTime  @default(now())

  pocConfig  PocConfig   @relation(fields: [pocConfigId], references: [id], onDelete: Cascade)
  results    EvalResult[]
}

model EvalResult {
  id          String   @id @default(uuid())
  evalCaseId  String
  runId       String
  status      String   @default("pending") // pending | running | passed | failed | errored
  score       Int?
  reasoning   String?
  rawResponse String?
  latencyMs   Int?
  createdAt   DateTime @default(now())

  pipelineTrace    String?
  errorDetail      String?
  failureStep      String?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?

  evalCase EvalCase @relation(fields: [evalCaseId], references: [id], onDelete: Cascade)
  evalRun  EvalRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model PocConfigVersion {
  id            String   @id @default(uuid())
  pocConfigId   String
  versionNumber Int
  systemPrompt  String
  tools         String
  changeLabel   String
  contentHash   String
  createdAt     DateTime @default(now())

  pocConfig PocConfig @relation(fields: [pocConfigId], references: [id], onDelete: Cascade)
  evalRuns  EvalRun[]

  @@unique([pocConfigId, versionNumber])
  @@index([pocConfigId])
}

model LlmConnection {
  id              String    @id @default(uuid())
  pocConfigId     String?
  name            String    @default("Default")
  isDefault       Boolean   @default(false)
  endpointUrl     String
  apiKey          String?
  apiKeyHint      String?
  model           String
  isActive        Boolean   @default(false)
  lastCheckedAt   DateTime?
  availableModels String?

  pocConfig          PocConfig?          @relation(fields: [pocConfigId], references: [id], onDelete: Cascade)
  taskModelOverrides TaskModelOverride[]

  @@index([pocConfigId])
}

model TaskModelOverride {
  id           String @id @default(uuid())
  pocConfigId  String
  taskType     String
  connectionId String
  model        String

  pocConfig  PocConfig     @relation(fields: [pocConfigId], references: [id], onDelete: Cascade)
  connection LlmConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([pocConfigId, taskType])
}

model EvalRun {
  id           String    @id @default(uuid())
  pocConfigId  String
  status       String    @default("pending") // pending | running | completed | failed
  totalCases   Int       @default(0)
  passedCases  Int       @default(0)
  failedCases  Int       @default(0)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  runNumber            Int       @default(0)
  evalSuiteVersionId   String?
  configVersionId               String?
  snapshotConfigVersionNumber   Int?
  snapshotSystemPrompt      String    @default("")
  snapshotModel             String    @default("")
  snapshotEndpointUrl       String    @default("")
  snapshotJudgeModel        String    @default("")
  snapshotJudgeProviderName String    @default("")

  pocConfig        PocConfig          @relation(fields: [pocConfigId], references: [id], onDelete: Cascade)
  evalSuiteVersion EvalSuiteVersion?  @relation(fields: [evalSuiteVersionId], references: [id], onDelete: SetNull)
  configVersion    PocConfigVersion?  @relation(fields: [configVersionId], references: [id], onDelete: SetNull)
  results          EvalResult[]
}

model EvalSuiteVersion {
  id            String    @id @default(uuid())
  pocConfigId   String
  versionNumber Int
  casesSnapshot String    // JSON: serialized EvalCase[]
  createdAt     DateTime  @default(now())

  pocConfig PocConfig @relation(fields: [pocConfigId], references: [id], onDelete: Cascade)
  runs      EvalRun[]
}
