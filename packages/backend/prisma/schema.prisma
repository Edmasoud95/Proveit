generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PocConfig {
  id           String   @id @default(uuid())
  name         String
  description  String
  systemPrompt String
  tools        String   @default("[]") // JSON array of tool definitions
  metadata     String   @default("{}") // JSON metadata
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  evalCases          EvalCase[]
  llmConnection      LlmConnection?
  evalRuns           EvalRun[]
  evalSuiteVersions  EvalSuiteVersion[]
}

model EvalCase {
  id             String    @id @default(uuid())
  pocConfigId    String
  name           String
  input          String    // JSON
  judgeCriteria  String
  order          Int       @default(0)
  createdAt      DateTime  @default(now())

  pocConfig  PocConfig   @relation(fields: [pocConfigId], references: [id], onDelete: Cascade)
  results    EvalResult[]
}

model EvalResult {
  id          String   @id @default(uuid())
  evalCaseId  String
  runId       String
  status      String   @default("pending") // pending | running | passed | failed | errored
  score       Int?
  reasoning   String?
  rawResponse String?
  latencyMs   Int?
  createdAt   DateTime @default(now())

  pipelineTrace String?
  errorDetail   String?
  failureStep   String?

  evalCase EvalCase @relation(fields: [evalCaseId], references: [id], onDelete: Cascade)
  evalRun  EvalRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model LlmConnection {
  id            String   @id @default(uuid())
  pocConfigId   String   @unique
  endpointUrl   String
  apiKey        String?
  model         String
  isActive      Boolean  @default(false)
  lastCheckedAt DateTime?

  pocConfig PocConfig @relation(fields: [pocConfigId], references: [id], onDelete: Cascade)
}

model EvalRun {
  id           String    @id @default(uuid())
  pocConfigId  String
  status       String    @default("pending") // pending | running | completed | failed
  totalCases   Int       @default(0)
  passedCases  Int       @default(0)
  failedCases  Int       @default(0)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  runNumber            Int       @default(0)
  evalSuiteVersionId   String?
  snapshotSystemPrompt String    @default("")
  snapshotModel        String    @default("")
  snapshotEndpointUrl  String    @default("")

  pocConfig        PocConfig          @relation(fields: [pocConfigId], references: [id], onDelete: Cascade)
  evalSuiteVersion EvalSuiteVersion?  @relation(fields: [evalSuiteVersionId], references: [id], onDelete: SetNull)
  results          EvalResult[]
}

model EvalSuiteVersion {
  id            String    @id @default(uuid())
  pocConfigId   String
  versionNumber Int
  casesSnapshot String    // JSON: serialized EvalCase[]
  createdAt     DateTime  @default(now())

  pocConfig PocConfig @relation(fields: [pocConfigId], references: [id], onDelete: Cascade)
  runs      EvalRun[]
}
